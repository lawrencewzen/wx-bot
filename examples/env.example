# wx-bot environment file (keep mode 0600). Do not commit secrets.
# systemd: EnvironmentFile=-%h/.config/wx-bot/env
# launchd: sourced by the wrapper before exec (set -a).
# Format: KEY=value  (no export). Uncomment and fill in:

# WXBOT_WEBHOOK_KEY=
# WXBOT_WEBHOOK_SECRET=
# WXBOT_LOCAL_API_TOKEN=

# Proxy: services do not inherit the shell's proxy variables. If this machine
# reaches the internet only through a proxy, copy them here (install.sh does
# this on Linux), e.g.:
# https_proxy=http://user:pass@proxy:3128
# no_proxy=localhost,127.0.0.1
